rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Phase 3: Primitive Definition ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Auth-based verification check
    function isVerifiedUser() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true;
    }

    // --- Phase 4: Collection Fortress ---

    // Private user data (Email, Favorites, etc)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
    }

    // Public profile data
    match /profiles/{userId} {
      function isValidProfile(data) {
        return data.get('displayName', '') is string && data.get('displayName', '').size() <= 100
            && data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 600
            && data.get('bio', '') is string && data.get('bio', '').size() <= 1500
            && data.get('city', '') is string && data.get('city', '').size() <= 150
            && data.get('interests', []) is list && data.get('interests', []).size() <= 30
            && data.get('isVerified', false) is bool;
      }

      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidProfile(incoming());
    }

    match /dinners/{dinnerId} {
      function isValidDinner(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 200
            && data.cuisine is string && data.cuisine.size() <= 50
            && data.price is number && data.price >= 1 && data.price <= 10000
            && data.guestsMax is number && data.guestsMax >= 1 && data.guestsMax <= 50
            && data.guestsCount is number && data.guestsCount >= 0 && data.guestsCount <= data.guestsMax
            && data.hostId == request.auth.uid
            && data.date is number && data.date > 0
            && (data.get('tags', []) is list && data.get('tags', []).size() <= 15)
            && (data.get('images', []) is list && data.get('images', []).size() <= 10)
            && (data.get('vibe', '') is string && data.get('vibe', '').size() <= 50);
      }

      allow read: if isSignedIn(); 
      allow create: if isSignedIn() && isValidDinner(incoming()) && isValidId(dinnerId);
      allow update: if isSignedIn() && (
        (isOwner(existing().hostId) && isValidDinner(incoming()) && incoming().hostId == existing().hostId) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['guestsCount']) && incoming().guestsCount >= 0)
      );
      allow delete: if isSignedIn() && isOwner(existing().hostId);
    }

    match /bookings/{bookingId} {
      function isValidBooking(data) {
        return isValidId(data.dinnerId)
            && data.guestId == request.auth.uid
            && isValidId(data.hostId)
            && data.status in ['pending', 'confirmed', 'rejected', 'cancelled']
            && data.guestCount is number && data.guestCount >= 1 && data.guestCount <= 10
            && data.guestId != data.hostId;
      }

      allow read: if isSignedIn() && (isOwner(resource.data.guestId) || isOwner(resource.data.hostId));
      allow create: if isSignedIn() && isValidBooking(incoming()) && isValidId(bookingId);
      allow update: if isSignedIn() && (
        (isOwner(existing().hostId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status in ['confirmed', 'rejected']) ||
        (isOwner(existing().guestId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'cancelled')
      );
    }

    match /confirmedAttendances/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /notifications/{userId}/items/{notifId} {
      allow read, update: if isOwner(userId);
      allow create: if isSignedIn();
    }

    match /waitlist/{entryId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isOwner(resource.data.hostId));
      allow create: if isSignedIn() && isOwner(incoming().userId);
      allow delete: if isSignedIn() && (isOwner(existing().userId) || isOwner(existing().hostId));
    }

    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
      }
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.guestId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        exists(/databases/$(database)/documents/confirmedAttendances/$(request.auth.uid + "_" + incoming().dinnerId));
    }

    match /mail/{mailId} {
      allow create: if isSignedIn();
    }
  }
}
