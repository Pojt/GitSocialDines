rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Phase 3: Primitive Definition ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Auth-based verification check
    function isVerifiedUser() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true;
    }

    // --- Phase 4: Collection Fortress ---

    match /users/{userId} {
      function isValidUser(data) {
        return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
            && data.photoURL is string && data.photoURL.size() <= 600
            && (data.get('bio', '') is string && data.get('bio', '').size() <= 1500)
            && (data.get('city', '') is string && data.get('city', '').size() <= 150)
            && (data.get('interests', []) is list && data.get('interests', []).size() <= 30)
            && data.isVerified is bool
            && (data.get('createdAt', 0) is number);
      }

      allow read: if true;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Only allow changing profile fields, NOT self-verifying once established (prototype exception for now)
        incoming().diff(existing()).affectedKeys().hasAny(['displayName', 'bio', 'city', 'interests', 'photoURL', 'isVerified'])
      );
    }

    match /dinners/{dinnerId} {
      function isValidDinner(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 200
            && data.cuisine is string && data.cuisine.size() <= 50
            && data.price is number && data.price >= 1 && data.price <= 10000
            && data.guestsMax is number && data.guestsMax >= 1 && data.guestsMax <= 50
            && data.guestsCount is number && data.guestsCount >= 0 && data.guestsCount <= data.guestsMax
            && data.hostId == request.auth.uid
            && data.date is number && data.date > 0
            && (data.get('tags', []) is list && data.get('tags', []).size() <= 15)
            && (data.get('images', []) is list && data.get('images', []).size() <= 5)
            && (data.get('vibe', '') is string && data.get('vibe', '').size() <= 50);
      }

      allow read: if true; 
      allow create: if isVerifiedUser() && isValidDinner(incoming()) && isValidId(dinnerId);
      allow update: if isSignedIn() && (
        // Action: Host Edit
        (isOwner(existing().hostId) && isValidDinner(incoming()) && incoming().hostId == existing().hostId) ||
        // Action: Guest Intake (Atomic increment check)
        (incoming().diff(existing()).affectedKeys().hasOnly(['guestsCount']) && incoming().guestsCount == existing().guestsCount + 1) ||
        // Action: Booking cancellation (decrement)
        (incoming().diff(existing()).affectedKeys().hasOnly(['guestsCount']) && incoming().guestsCount < existing().guestsCount && incoming().guestsCount >= 0)
      );
      allow delete: if isSignedIn() && isOwner(existing().hostId);
    }

    match /bookings/{bookingId} {
      function isValidBooking(data) {
        return isValidId(data.dinnerId)
            && data.guestId == request.auth.uid
            && isValidId(data.hostId)
            && data.status in ['pending', 'confirmed', 'rejected', 'cancelled']
            && data.guestCount is number && data.guestCount >= 1 && data.guestCount <= 10
            && data.guestId != data.hostId
            && (data.get('message', '') is string && data.get('message', '').size() <= 1000);
      }

      allow read: if isSignedIn() && (isOwner(resource.data.guestId) || isOwner(resource.data.hostId));
      
      allow create: if isSignedIn() && isValidBooking(incoming()) && isValidId(bookingId) &&
        exists(/databases/$(database)/documents/dinners/$(incoming().dinnerId));

      allow update: if isSignedIn() && (
        // Action: Host Confirmation/Rejection
        (isOwner(existing().hostId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status in ['confirmed', 'rejected']) ||
        // Action: Guest Cancellation
        (isOwner(existing().guestId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'cancelled')
      );
      allow delete: if false; // Prefer soft-cancel
    }

    match /reviews/{reviewId} {
      function isValidReview(data) {
        return data.rating is number && data.rating >= 1 && data.rating <= 5
            && data.content is string && data.content.size() <= 2000
            && data.authorId == request.auth.uid
            && isValidId(data.dinnerId)
            && isValidId(reviewId);
      }

      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming()) &&
        exists(/databases/$(database)/documents/confirmedAttendances/$(request.auth.uid + "_" + incoming().dinnerId));
    }

    match /confirmedAttendances/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /waitlist/{entryId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || resource.data.hostId == request.auth.uid
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || resource.data.hostId == request.auth.uid
      );
      allow update: if false;
    }

    match /notifications/{userId}/items/{notifId} {
      allow read, update: if isOwner(userId);
      allow create: if isSignedIn(); // any auth user can send a notification to another user
      allow delete: if false;
    }

    match /mail/{mailId} {
      allow create: if isSignedIn(); // Allow authenticated users to queue system emails
      allow read, update, delete: if false; // Only system/admin should process
    }
  }
}
